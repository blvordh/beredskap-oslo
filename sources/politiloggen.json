 "data": {
  "entries": [
   {
    "id": "26hjb1-3",
    "thread_id": "26hjb1",
    "text": "Bussen er fjernet og trafikken går som normalt.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmen",
    "created": "2026-11-21T12:44:00.193110+00:00",
    "updated": "2026-11-21T12:44:00.1931109+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26hjb1-3"
   },
   {
    "id": "26hjb1-2",
    "thread_id": "26hjb1",
    "text": "Alle passasjerne er sjekket og ingen har behov for ytterlig helseoppfølgning. Snakk om teknisk feil på bremser som har gitt varmgang og røyk.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmen",
    "created": "2026-11-21T11:52:20.661416+00:00",
    "updated": "2026-11-21T11:52:20.6614164+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26hjb1-2"
   },
   {
    "id": "26hjb1-1",
    "thread_id": "26hjb1",
    "text": "Patruljen melder at dette fremstår udramatisk, noen passasjerer sjekkes av ambulanse ifm røykeksponering. Bilberger er på vei for å hente bussen.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmen",
    "created": "2026-11-21T11:47:49.384022+00:00",
    "updated": "2026-11-21T11:47:49.3840225+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26hjb1-1"
   },
   {
    "id": "26hjb1-0",
    "thread_id": "26hjb1",
    "text": "I Stasjonsveien krysset Tråkka er det meldt om røykutvikling i en buss. Bussen er evakuert og nødetatene er på vei.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmen",
    "created": "2026-11-21T11:42:28.034571+00:00",
    "updated": "2026-11-21T11:42:28.0879525+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26hjb1-0"
   },
   {
    "id": "26x50q-0",
    "thread_id": "26x50q",
    "text": "Vi har gjennomført en promillekontroll ifm ankomst av Kiel-fergen. Totalt ble 180 bilførere kontrollert. Vi er meget fornøyd med at alle kontrollerte blåste til 0,0.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Hjortnes",
    "created": "2026-11-21T10:53:09.356460+00:00",
    "updated": "2026-11-21T10:53:09.4144137+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26x50q-0"
   },
   {
    "id": "26q36q-2",
    "thread_id": "26q36q",
    "text": "Brannvesenet blir igjen for kontroll/etterslukking. Beboerne har fått husly hos en nabo. Vi oppretter sak.",
    "category": "Brann",
    "municipality": "Bærum",
    "area": "Jar",
    "created": "2026-11-21T07:16:14.617185+00:00",
    "updated": "2026-11-21T07:16:14.6171855+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26q36q-2"
   },
   {
    "id": "26q36q-0",
    "thread_id": "26q36q",
    "text": "Politi og brann rykket ut til en brann i enebolig på Jar. Brannen er nå slukket. Ingen personer er skadet.",
    "category": "Brann",
    "municipality": "Bærum",
    "area": "Jar",
    "created": "2026-11-21T05:59:24.365012+00:00",
    "updated": "2026-11-21T05:59:24.4164434+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26q36q-0"
   },
   {
    "id": "26gmj9-3",
    "thread_id": "26gmj9",
    "text": "Det var et lite branntilløp på stedet, men dette ble slukket før det utviklet seg. Ingen skade på verken person eller inventar/ lokale. Vi oppretter sak. Ferdige på stedet.",
    "category": "Brann",
    "municipality": "Oslo",
    "area": "Sentrum",
    "created": "2026-11-21T02:12:26.602161+00:00",
    "updated": "2026-11-21T02:12:26.6021613+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26gmj9-3"
   },
   {
    "id": "26gmj9-0",
    "thread_id": "26gmj9",
    "text": "Nødetatene er i Hegdehaugsveien 25 A hvor det er røyk i et lokale. Det er ikke bekreftet brann, men beboere og andre er evakuert.",
    "category": "Brann",
    "municipality": "Oslo",
    "area": "Sentrum",
    "created": "2026-11-21T01:37:41.614667+00:00",
    "updated": "2026-11-21T01:37:41.6666921+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26gmj9-0"
   },
   {
    "id": "264tw2-3",
    "thread_id": "264tw2",
    "text": "Veien er nå ryddet og trafikken går som normalt forbi stedet. Politiet oppretter sak. Ingen personer ble skadet i ulykken, men begge de involverte kjøretøyene måtte fraktes vekk av Redgo.",
    "category": "Trafikk",
    "municipality": "Asker",
    "area": "Røykenveien",
    "created": "2026-11-20T20:47:19.247138+00:00",
    "updated": "2026-11-20T20:47:19.2471385+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/264tw2-3"
   },
   {
    "id": "264tw2-1",
    "thread_id": "264tw2",
    "text": "Trafikken går nå forbi ulykkesstedet i ett felt. Manuell dirigering på stedet.",
    "category": "Trafikk",
    "municipality": "Asker",
    "area": "Røykenveien",
    "created": "2026-11-20T20:07:56.922749+00:00",
    "updated": "2026-11-20T20:07:56.9227492+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/264tw2-1"
   },
   {
    "id": "264tw2-0",
    "thread_id": "264tw2",
    "text": "Melding om trafikkulykke på Røykenveien rett sør for Nyhuskollen. To biler involvert, den ene av disse har veltet og ligger i skråningen ved siden av veien. Det er ikke melding om alvorlig personskade men det er noe trafikale utfordringer på stedet. Politiet på stedet, og øvrige nødetater på vei.",
    "category": "Trafikk",
    "municipality": "Asker",
    "area": "Røykenveien",
    "created": "2026-11-20T19:49:43.477321+00:00",
    "updated": "2026-11-20T19:49:43.5711674+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/264tw2-0"
   },
   {
    "id": "26pv4p-3",
    "thread_id": "26pv4p",
    "text": "Bilde av våpen tatt fra mistenkte på Oslo City.",
    "category": "Ro og orden",
    "municipality": "Oslo politidistrikt",
    "area": "",
    "created": "2026-11-20T16:03:34.557862+00:00",
    "updated": "2026-11-20T16:03:34.5578629+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26pv4p-3"
   },
   {
    "id": "26pv4p-0",
    "thread_id": "26pv4p",
    "text": "Oslo City: Melding fra vektere om en person som stod med et replikagevær inne i en butikk. Det var ingen trusselsituasjon i sammenheng med dette og personen ble tatt kontroll på uten dramatikk. Personen anmeldes for forholdet.",
    "category": "Ro og orden",
    "municipality": "Oslo politidistrikt",
    "area": "",
    "created": "2026-11-20T15:38:34.089677+00:00",
    "updated": "2026-11-20T15:38:34.1412483+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26pv4p-0"
   },
   {
    "id": "26mcnv-2",
    "thread_id": "26mcnv",
    "text": "Fornærmede ikke alvorlig skadet. Vi oppretter sak. Vi søker fortsatt etter gjerningspersonene.",
    "category": "Voldshendelse",
    "municipality": "Oslo",
    "area": "Grønland",
    "created": "2026-11-20T05:15:40.844733+00:00",
    "updated": "2026-11-20T05:15:40.8447336+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mcnv-2"
   },
   {
    "id": "26mcnv-1",
    "thread_id": "26mcnv",
    "text": "Vi er på stedet. Fornærmede er ved bevissthet. Han blør fra hodet. Vi søker etter en gjeng unge menn som skal ha løpt retning Grønland torg.",
    "category": "Voldshendelse",
    "municipality": "Oslo",
    "area": "Grønland",
    "created": "2026-11-20T04:50:58.780049+00:00",
    "updated": "2026-11-20T04:50:58.7800495+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mcnv-1"
   },
   {
    "id": "26mcnv-0",
    "thread_id": "26mcnv",
    "text": "Vi er på vei til Nordbygata. Der skal det ha vært et slagsmål på gaten. Flere skal ha gått løs på en person. Meldingene beskriver en person liggende bevisstløs på bakken. Ambulanse er også på vei.",
    "category": "Voldshendelse",
    "municipality": "Oslo",
    "area": "Grønland",
    "created": "2026-11-20T04:48:03.948258+00:00",
    "updated": "2026-11-20T04:48:03.9955042+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mcnv-0"
   },
   {
    "id": "26n7r7-4",
    "thread_id": "26n7r7",
    "text": "Bilfører tatt med til legevakt for sjekk. Trolig har bilfører brutt vikeplikten, og førerkort er tatt i beslag. Sak opprettes.",
    "category": "Ulykke",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-19T23:36:47.217994+00:00",
    "updated": "2026-11-19T23:36:47.2179942+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7r7-4"
   },
   {
    "id": "26n7r7-3",
    "thread_id": "26n7r7",
    "text": "Bilfører tilsees av helsepersonell på stedet. Trikken har gjenopptatt normal trafikk.",
    "category": "Ulykke",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-19T22:21:27.409766+00:00",
    "updated": "2026-11-19T22:21:27.4097663+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7r7-3"
   },
   {
    "id": "26n7r7-1",
    "thread_id": "26n7r7",
    "text": "Nødetatene er fremme på stedet. Bilfører er ute av bilen og fremstår ikke alvorlig skadet.",
    "category": "Ulykke",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-19T21:52:28.604442+00:00",
    "updated": "2026-11-19T21:52:28.6044426+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7r7-1"
   },
   {
    "id": "26n7r7-0",
    "thread_id": "26n7r7",
    "text": "Melding om sammenstøt mellom personbil og trikk i Thorvald Meyers gate. Per nå ukjent omfang.",
    "category": "Ulykke",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-19T21:45:40.995534+00:00",
    "updated": "2026-11-19T21:45:41.0599364+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7r7-0"
   },
   {
    "id": "263d0x-0",
    "thread_id": "263d0x",
    "text": "Nødetatene er På Rodeløkka der det har vært brann i en madrass som var på en balkong. Brannen er slukket og det er ingen personskader.",
    "category": "Brann",
    "municipality": "Oslo",
    "area": "Rodeløkka",
    "created": "2026-11-19T14:44:49.973309+00:00",
    "updated": "2026-11-19T14:44:50.0260024+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/263d0x-0"
   },
   {
    "id": "268vpl-1",
    "thread_id": "268vpl",
    "text": "Bilene er flyttet og trafikken går som normalt.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Karihaugen",
    "created": "2026-11-18T17:13:53.779085+00:00",
    "updated": "2026-11-18T17:13:53.7790855+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/268vpl-1"
   },
   {
    "id": "268vpl-0",
    "thread_id": "268vpl",
    "text": "Nødetatene er på E6 inngående på Karihaugen der det har vært et sammenstøt mellom en lastebil og en personbil. Personene som var i kjøretøyene sier seg uskadd.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Karihaugen",
    "created": "2026-11-18T17:07:39.673971+00:00",
    "updated": "2026-11-18T17:07:39.7760057+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/268vpl-0"
   },
   {
    "id": "26knqd-2",
    "thread_id": "26knqd",
    "text": "Et felt er åpent forbi ulykkesstedet og trafikken dirigeres manuelt.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmenkollen",
    "created": "2026-11-18T17:04:10.367266+00:00",
    "updated": "2026-11-18T17:04:10.3672667+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26knqd-2"
   },
   {
    "id": "26knqd-0",
    "thread_id": "26knqd",
    "text": "Nødetatene er i Holmenkollveien der det har vært en singelulykke. En bil har kjørt av veien og truffet en fjellvegg. Vi er i kontakt med sjåføren som er våken og kan gjør rede for seg.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Holmenkollen",
    "created": "2026-11-18T16:58:41.446978+00:00",
    "updated": "2026-11-18T16:58:41.5072108+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26knqd-0"
   },
   {
    "id": "2637rm-2",
    "thread_id": "2637rm",
    "text": "Nødetatene er på stedet. Det er ingen alvorlige personskader. Kjøretøyene er kjørebare og de kjører videre og av E18.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "E6 Utgående Trosterud",
    "created": "2026-11-18T15:42:22.349415+00:00",
    "updated": "2026-11-18T15:42:22.3494159+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/2637rm-2"
   },
   {
    "id": "2637rm-1",
    "thread_id": "2637rm",
    "text": "Det har vært et sammenstøt mellom en lastebil og en personbil ifm filskifte.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "E6 Utgående Trosterud",
    "created": "2026-11-18T15:33:50.158697+00:00",
    "updated": "2026-11-18T15:33:50.158697+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/2637rm-1"
   },
   {
    "id": "2637rm-0",
    "thread_id": "2637rm",
    "text": "Nødetatene er på vei til E6 utgående ved avkjøring til Trosterud der det har vært en trafikkulykke.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "E6 Utgående Trosterud",
    "created": "2026-11-18T15:30:09.379087+00:00",
    "updated": "2026-11-18T15:30:09.4281178+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/2637rm-0"
   },
   {
    "id": "269qt2-0",
    "thread_id": "269qt2",
    "text": "Politiet er på Bekkestua der en fotgjenger har blitt påkjørt av en bil. Vi er i kontakt med begge parter. Det er ikke alvorlige personskader.",
    "category": "Trafikk",
    "municipality": "Bærum",
    "area": "Bekkestua",
    "created": "2026-11-18T15:15:59.526865+00:00",
    "updated": "2026-11-18T15:15:59.5758712+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/269qt2-0"
   },
   {
    "id": "26nt45-5",
    "thread_id": "26nt45",
    "text": "Vi er ferdig på stedet, sak opprettes.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Voldsløkka",
    "created": "2026-11-18T09:51:17.655423+00:00",
    "updated": "2026-11-18T09:51:17.6554239+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26nt45-5"
   },
   {
    "id": "26nt45-3",
    "thread_id": "26nt45",
    "text": "Sykelisten kjøres sykehus for videre behandling.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Voldsløkka",
    "created": "2026-11-18T09:23:42.271013+00:00",
    "updated": "2026-11-18T09:23:42.2710139+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26nt45-3"
   },
   {
    "id": "26nt45-0",
    "thread_id": "26nt45",
    "text": "Ambulanse og vi er ved Voldsløkka skole etter en melding om trafikkuhell mellom bil og sykkel. Ambulanse sjekker ut sykelisten som er bevist, men forslått. Vi har tatt kontroll på bilfører som vi mistenker er påvirket av rusmidler. Fremstilles for blodprøve.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Voldsløkka",
    "created": "2026-11-18T09:08:08.618930+00:00",
    "updated": "2026-11-18T09:08:08.6699937+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26nt45-0"
   },
   {
    "id": "26r7c3-0",
    "thread_id": "26r7c3",
    "text": "Oslo Politidistrikt vil i dag gjennomføre øvingsaktivitet. Øvelsen vil medføre utrykningskjøring, synlig bevæpnet politipersonell og noe støy ifm smell og helikoptertrafikk. Aktuelle områder vil merkes med øvelse politi skilt. Tidsrommet er mellom 07-15.",
    "category": "Andre hendelser",
    "municipality": "Oslo politidistrikt",
    "area": "",
    "created": "2026-11-18T06:48:00.584138+00:00",
    "updated": "2026-11-18T06:48:00.7358094+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26r7c3-0"
   },
   {
    "id": "26mnm4-2",
    "thread_id": "26mnm4",
    "text": "Fotgjenger kjørt legevakt for sjekk. Fører av bilen anmeldes for forholdet. Nødetatene ferdig på stedet.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Stovner",
    "created": "2026-11-17T17:56:32.194063+00:00",
    "updated": "2026-11-17T17:56:32.1940631+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mnm4-2"
   },
   {
    "id": "26mnm4-1",
    "thread_id": "26mnm4",
    "text": "Politi og ambulanse på stedet. Den skadde tilses av helsepersonell. Politi er i kontakt med alle involverte parter.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Stovner",
    "created": "2026-11-17T16:37:56.057246+00:00",
    "updated": "2026-11-17T16:37:56.0572467+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mnm4-1"
   },
   {
    "id": "26mnm4-0",
    "thread_id": "26mnm4",
    "text": "Nødetatene rykker ut til Aastatunet, hvor det har vært et sammenstøt mellom en bil og en fotgjenger. Fotgjenger er oppegående og fremstår innledningsvis ikke alvorlig skadd. Hendelsen skal ha skjedd i et lyskryss.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Stovner",
    "created": "2026-11-17T16:21:41.280359+00:00",
    "updated": "2026-11-17T16:21:41.3299877+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26mnm4-0"
   },
   {
    "id": "26l6rr-1",
    "thread_id": "26l6rr",
    "text": "Vognen er berget fra stedet. Det vil pågå noe arbeid utover, for å utbedre noe skader på sporet. Nødetatene er ferdig.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "",
    "created": "2026-11-17T14:50:00.295202+00:00",
    "updated": "2026-11-17T14:50:00.2952023+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26l6rr-1"
   },
   {
    "id": "26l6rr-0",
    "thread_id": "26l6rr",
    "text": "Det er meldt om en trikk som har sporet av i Thorvald Meyers gate. Det er ikke meldt om skade på personer. Det jobbes med berging, men dette vil ta noe tid.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "",
    "created": "2026-11-17T13:52:42.798737+00:00",
    "updated": "2026-11-17T13:52:42.8490329+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26l6rr-0"
   },
   {
    "id": "26rbh5-3",
    "thread_id": "26rbh5",
    "text": "Fornærmede ble tatt med av ambulanse for videre undersøkelser. Fører av personbilen ble fratatt førerretten på stedet og anmeldes for brudd på vegtrafikkloven.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Manglerud Senter",
    "created": "2026-11-17T11:21:36.454588+00:00",
    "updated": "2026-11-17T11:21:36.454588+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26rbh5-3"
   },
   {
    "id": "26rbh5-2",
    "thread_id": "26rbh5",
    "text": "Den påkjørte får tilsyn av ambulansepersonell på stedet. Klager på store smerter. Vi er i kontakt med alle involverte og jobber med å avklare hendelsesforløpet.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Manglerud Senter",
    "created": "2026-11-17T10:03:47.015374+00:00",
    "updated": "2026-11-17T10:03:47.015374+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26rbh5-2"
   },
   {
    "id": "26rbh5-0",
    "thread_id": "26rbh5",
    "text": "Vi er på vei til Manglerud senter hvor en person skal være påkjørt av en bil. Vedkommende skal være våken og bevisst men klager på smerter. Ambulanse er også på vei til stedet.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Manglerud Senter",
    "created": "2026-11-17T09:53:41.112349+00:00",
    "updated": "2026-11-17T09:53:41.1771555+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26rbh5-0"
   },
   {
    "id": "26m2r9-1",
    "thread_id": "26m2r9",
    "text": "Begge kjøretøy er kjørbare og det skal ikke være personskade på de involverte. De kjører til egnet sted for å fylle ut skademelding og det er fri ferdsel på stedet.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "E6 Inngående Høybråten",
    "created": "2026-11-17T06:46:52.737405+00:00",
    "updated": "2026-11-17T06:46:52.7374059+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26m2r9-1"
   },
   {
    "id": "26m2r9-0",
    "thread_id": "26m2r9",
    "text": "På E6 inngående på høyde med Høybråten har det vært et sammenstøt mellom en personbil og en trailer. Involverte kjøretøy står i høyre kjørefelt og trafikken går sakte forbi i øvrige felt. Vi er på vei til stedet.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "E6 Inngående Høybråten",
    "created": "2026-11-17T06:39:41.972984+00:00",
    "updated": "2026-11-17T06:39:42.0212535+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26m2r9-0"
   },
   {
    "id": "266dg3-1",
    "thread_id": "266dg3",
    "text": "Hendelsen skal ha skjedd i et fotgjengerfelt på stedet. Den påkjørte klager på noe smerter og kjøres til legevakten for sjekk. Førerkort til bilfører tas i beslag og sak opprettes.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-16T15:37:40.967539+00:00",
    "updated": "2026-11-16T15:37:40.967539+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/266dg3-1"
   },
   {
    "id": "266dg3-0",
    "thread_id": "266dg3",
    "text": "Politi er sammen med ambulanse på stedet ved Schous plass, hvor det har vært et sammenstøt mellom bil og fotgjenger. Fotgjenger skal være våken og bevisst.",
    "category": "Trafikk",
    "municipality": "Oslo",
    "area": "Grünerløkka",
    "created": "2026-11-16T15:23:25.212869+00:00",
    "updated": "2026-11-16T15:23:25.3093471+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/266dg3-0"
   },
   {
    "id": "26n7ph-2",
    "thread_id": "26n7ph",
    "text": "Bilbergeing er på stedet. Fører av varebilen får sitt førerkort beslaglagt på stedet og anmeldes for brudd på vegtrafikkloven. En person, med mulig brudd i armen, er ivaretatt av helse for videre undersøkelser.",
    "category": "Trafikk",
    "municipality": "Oslo politidistrikt",
    "area": "",
    "created": "2026-11-16T13:40:23.346515+00:00",
    "updated": "2026-11-16T13:40:23.3465155+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7ph-2"
   },
   {
    "id": "26n7ph-0",
    "thread_id": "26n7ph",
    "text": "RV4 Skillebekk inn mot Oslo - melding om trafikkulykke. Sammenstøt mellom to biler. Trafikken går sakte forbi i ett felt. Nødetater er på stedet.",
    "category": "Trafikk",
    "municipality": "Oslo politidistrikt",
    "area": "",
    "created": "2026-11-16T12:47:14.525900+00:00",
    "updated": "2026-11-16T12:47:14.5773393+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26n7ph-0"
   },
   {
    "id": "26nnxh-1",
    "thread_id": "26nnxh",
    "text": "Bilen er berget og det er fri ferdsel på stedet.",
    "category": "Trafikk",
    "municipality": "Bærum",
    "area": "E18 Utgående Strand",
    "created": "2026-11-16T09:04:38.063395+00:00",
    "updated": "2026-11-16T09:04:38.0633951+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26nnxh-1"
   },
   {
    "id": "26nnxh-0",
    "thread_id": "26nnxh",
    "text": "I midtre felt på E18 rett før Strand står det en bil med havari. Bilberging er på vei.",
    "category": "Trafikk",
    "municipality": "Bærum",
    "area": "E18 Utgående Strand",
    "created": "2026-11-16T08:23:24.792259+00:00",
    "updated": "2026-11-16T08:48:20.304155+00:00",
    "active": false,
    "link": "https://www.politiet.no/politiloggen/hendelse/26nnxh-0"
   }
